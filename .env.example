# --- AI chatbot (Gemini) ---
GEMINI_API_KEY=
# Optional. Defaults to the "latest" Flash alias.
GEMINI_MODEL=gemini-flash-latest

# --- Accounts (Supabase). Run supabase/schema.sql first. Server-side only. ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend). The sending domain must be verified in Resend. ---
RESEND_API_KEY=
EMAIL_FROM="Pehla Qadam <lessons@yourdomain.com>"

# --- Public site URL, used for links inside emails ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Protects the weekly cron route. Vercel sends it automatically. ---
CRON_SECRET=

# --- Pricing ---
# Public address for the "Talk to us" link on the Teams plan. Leave empty to hide the link.
NEXT_PUBLIC_CONTACT_EMAIL=
# Where plan-request notifications go (your own inbox). Needs the Resend settings above.
NOTIFY_EMAIL=
